---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LessonCard from '../../components/LessonCard.astro';
import { getCollection } from 'astro:content';

const lessons = (await getCollection('lessons'))
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

const freeLessons = lessons.filter(l => l.data.free);
const premiumLessons = lessons.filter(l => !l.data.free);
---

<BaseLayout
  title="Lessons"
  description="Free and premium guitar lessons covering classical technique, fingerstyle, and more."
>
  <div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-serif font-bold mb-2">Lessons</h1>
    <p class="text-gray-500 mb-10">
      Classical guitar, fingerstyle, and music theory — for all levels.
    </p>

    {freeLessons.length > 0 && (
      <section class="mb-12">
        <h2 class="text-xl font-serif font-semibold mb-6 flex items-center gap-3">
          Free Lessons
          <span class="text-xs font-sans font-medium bg-green-50 text-green-700 border border-green-200 px-2 py-0.5 rounded">
            No signup required
          </span>
        </h2>
        <div class="grid md:grid-cols-2 gap-6">
          {freeLessons.map(lesson => (
            <LessonCard
              title={lesson.data.title}
              description={lesson.data.description}
              free={lesson.data.free}
              level={lesson.data.level}
              tags={lesson.data.tags}
              slug={lesson.slug}
            />
          ))}
        </div>
      </section>
    )}

    {premiumLessons.length > 0 && (
      <section>
        <h2 class="text-xl font-serif font-semibold mb-6 flex items-center gap-3">
          Premium Lessons
          <span class="text-xs font-sans font-medium bg-amber-50 text-amber-800 border border-amber-200 px-2 py-0.5 rounded">
            One-time purchase
          </span>
        </h2>
        <div class="grid md:grid-cols-2 gap-6">
          {premiumLessons.map(lesson => (
            <LessonCard
              title={lesson.data.title}
              description={lesson.data.description}
              free={lesson.data.free}
              level={lesson.data.level}
              tags={lesson.data.tags}
              slug={lesson.slug}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
