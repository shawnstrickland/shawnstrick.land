---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative h-screen flex items-center justify-center">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/images/fenway-seats.jpeg')"
    >
      <div class="absolute inset-0 bg-black/65"></div>
    </div>
    <div class="relative z-10 text-center text-white px-4 max-w-2xl mx-auto">
      <h1 class="text-5xl md:text-7xl font-serif font-bold mb-4 tracking-tight">
        Shawn Strickland
      </h1>
      <p class="text-base md:text-lg text-gray-300 mb-6 tracking-[0.2em] uppercase">
        Developer &middot; Teacher &middot; Musician &middot; Dad
      </p>
      <p class="text-base md:text-lg text-gray-300 leading-relaxed">
        A wise man once said{' '}
        <a
          href="https://www.hanselman.com/blog/your-words-are-wasted"
          class="underline underline-offset-2 hover:text-amber-400 transition-colors"
          target="_blank"
          rel="noopener noreferrer"
        >
          own your words
        </a>. This is my personal repository.
      </p>
      <div class="mt-10 flex flex-wrap gap-4 justify-center">
        <a
          href="/posts"
          class="bg-amber-700 text-white px-8 py-3 text-sm font-medium hover:bg-amber-800 transition-colors rounded"
        >
          Read the blog
        </a>
        <a
          href="/lessons"
          class="border border-white/50 text-white px-8 py-3 text-sm font-medium hover:bg-white/10 transition-colors rounded"
        >
          Music lessons
        </a>
      </div>
    </div>
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/40 text-sm animate-bounce select-none">
      &#8595;
    </div>
  </section>

  <!-- Recent Posts -->
  <section class="max-w-5xl mx-auto px-4 py-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-serif font-bold">Recent Posts</h2>
      <a href="/posts" class="text-sm text-amber-700 hover:underline">All posts &rarr;</a>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map(post => (
        <PostCard
          title={post.data.title}
          pubDate={post.data.pubDate}
          description={post.data.description}
          slug={post.slug}
          tags={post.data.tags}
        />
      ))}
    </div>
  </section>

  <!-- What's here -->
  <section class="bg-gray-50 border-y border-gray-200">
    <div class="max-w-5xl mx-auto px-4 py-16">
      <h2 class="text-2xl font-serif font-bold mb-8 text-center">What you'll find here</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <a
          href="/music"
          class="bg-white border border-gray-200 rounded-md p-6 hover:border-amber-300 hover:shadow-sm transition-all block"
        >
          <h3 class="font-serif font-semibold text-lg mb-2">Music</h3>
          <p class="text-sm text-gray-600">Classical guitar, recordings, and musical projects.</p>
        </a>
        <a
          href="/lessons"
          class="bg-white border border-gray-200 rounded-md p-6 hover:border-amber-300 hover:shadow-sm transition-all block"
        >
          <h3 class="font-serif font-semibold text-lg mb-2">Lessons</h3>
          <p class="text-sm text-gray-600">Free and premium guitar lessons for all levels.</p>
        </a>
        <a
          href="/downloads"
          class="bg-white border border-gray-200 rounded-md p-6 hover:border-amber-300 hover:shadow-sm transition-all block"
        >
          <h3 class="font-serif font-semibold text-lg mb-2">Downloads</h3>
          <p class="text-sm text-gray-600">Sheet music, PDFs, and other resources.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
