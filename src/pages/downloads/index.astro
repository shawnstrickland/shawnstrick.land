---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DownloadCard from '../../components/DownloadCard.astro';
import { getCollection } from 'astro:content';

const downloads = (await getCollection('downloads'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Downloads"
  description="Sheet music, PDFs, and other resources from Shawn Strickland."
>
  <div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-serif font-bold mb-2">Downloads</h1>
    <p class="text-gray-500 mb-10">
      Sheet music, slide decks, and other materials. Free resources are available immediately.
    </p>
    <div class="grid md:grid-cols-2 gap-6">
      {downloads.map(dl => (
        <DownloadCard
          title={dl.data.title}
          description={dl.data.description}
          price={dl.data.price}
          fileUrl={dl.data.fileUrl}
          lsProductId={dl.data.lsProductId}
          type={dl.data.type}
          slug={dl.slug}
        />
      ))}
    </div>
  </div>
</BaseLayout>
