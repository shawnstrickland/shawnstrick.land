---
interface Props {
  title: string;
  description: string;
  free: boolean;
  level?: string;
  tags?: string[];
  slug: string;
}

const { title, description, free, level, tags, slug } = Astro.props;
---

<article class="border border-gray-200 rounded-md p-6 hover:border-amber-300 hover:shadow-sm transition-all">
  <div class="flex items-start justify-between gap-4 mb-1">
    <h2 class="text-xl font-serif font-semibold leading-snug">
      <a href={`/lessons/${slug}`} class="hover:text-amber-700 transition-colors">{title}</a>
    </h2>
    <span class={`shrink-0 text-xs px-2 py-0.5 rounded font-medium mt-1 ${
      free ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-amber-50 text-amber-800 border border-amber-200'
    }`}>
      {free ? 'Free' : 'Premium'}
    </span>
  </div>
  {level && <p class="text-xs text-gray-400 capitalize mb-2">{level}</p>}
  <p class="text-gray-600 text-sm leading-relaxed">{description}</p>
  {tags && tags.length > 0 && (
    <div class="flex gap-2 mt-3 flex-wrap">
      {tags.map(tag => (
        <span class="text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded">{tag}</span>
      ))}
    </div>
  )}
</article>
