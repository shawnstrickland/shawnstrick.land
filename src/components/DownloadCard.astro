---
interface Props {
  title: string;
  description: string;
  price: number;
  fileUrl?: string;
  lsProductId?: string;
  type: string;
  slug: string;
}

const { title, description, price, fileUrl, lsProductId, type } = Astro.props;
const isFree = price === 0;
const typeLabel = type.replace('-', ' ');
---

<article class="border border-gray-200 rounded-md p-6">
  <div class="flex items-start justify-between gap-4 mb-2">
    <div>
      <span class="text-xs uppercase tracking-wider text-gray-400 block mb-1">{typeLabel}</span>
      <h2 class="text-xl font-serif font-semibold leading-snug">{title}</h2>
    </div>
    <span class="shrink-0 text-lg font-bold text-amber-700 mt-1">
      {isFree ? 'Free' : `$${price}`}
    </span>
  </div>
  <p class="text-gray-600 text-sm leading-relaxed mt-2 mb-4">{description}</p>
  {isFree && fileUrl ? (
    <a
      href={fileUrl}
      download
      class="inline-block bg-amber-700 text-white text-sm px-5 py-2 rounded hover:bg-amber-800 transition-colors font-medium"
    >
      Download
    </a>
  ) : lsProductId ? (
    <a
      href={`https://shawnstrickland.lemonsqueezy.com/checkout/buy/${lsProductId}`}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block bg-amber-700 text-white text-sm px-5 py-2 rounded hover:bg-amber-800 transition-colors font-medium"
    >
      Buy Now
    </a>
  ) : null}
</article>
